@page "/test"
@using DiplomaProject.Services
@using DiplomaProject.Models


@inject TabItemService TabItemService
@inject GeminiTestGeneration GeminiTestGeneration
@inject GeminiPdfService GeminiPdfService
@inject TestEvaluationService EvaluationService
@inject JsonDataService JsonDataService
@inject SaveTestService SaveTestService

@rendermode InteractiveServer

@if (!state.IsGenerated && !state.IsLoadedFromDb)
{
    <div class="generator-wrapper">

        <div class="generator-header">
            <h2>Генератор тестових завдань</h2>
            <p>Створення тестів за темою, JSON або PDF</p>
        </div>

        <!-- MODE SWITCH -->
        <div class="mode-panel">

            <div class="mode-list">

                <!-- TOPIC -->
                <button class="mode-card @(state.Mode == GenerationMode.Topic ? "active-mode" : "")"
                        @onclick="() => SetMode(GenerationMode.Topic)">

                    <div>
                        <div class="mode-title">
                            Генерація за темою
                        </div>

                        <div class="mode-description">
                            Створення тесту через AI
                        </div>
                    </div>

                    @if (state.Mode == GenerationMode.Topic)
                    {
                        <span class="mode-indicator">●</span>
                    }

                </button>

                <!-- JSON -->
                <button class="mode-card @(state.Mode == GenerationMode.Json ? "active-mode" : "")"
                        @onclick="() => SetMode(GenerationMode.Json)">

                    <div>
                        <div class="mode-title">
                            Генерація за JSON файлом
                        </div>

                        <div class="mode-description">
                            Імпорт готового тесту
                        </div>
                    </div>

                    @if (state.Mode == GenerationMode.Json)
                    {
                        <span class="mode-indicator">●</span>
                    }

                </button>

                <!-- PDF -->
                <button class="mode-card @(state.Mode == GenerationMode.Pdf ? "active-mode" : "")"
                        @onclick="() => SetMode(GenerationMode.Pdf)">

                    <div>
                        <div class="mode-title">
                            Генерація за PDF файлом
                        </div>

                        <div class="mode-description">
                            Аналіз документа та генерація
                        </div>
                    </div>

                    @if (state.Mode == GenerationMode.Pdf)
                    {
                        <span class="mode-indicator">●</span>
                    }

                </button>

            </div>

        </div>

        <!-- INPUT CARD -->
        <div class="generator-card">

            @if (state.Mode == GenerationMode.Topic)
            {
                <div class="input-group-custom">

                    <div class="mode-title">
                        Тема тесту
                    </div>

                    <input class="custom-input"
                           @bind="state.Topic"
                           @oninput="OnInputChanged"
                           placeholder="Введіть тему тесту" />

                </div>

                <div class="input-group-custom">
                    <div class="mode-title">
                        Інструкції
                    </div>
                    

                    <textarea class="custom-textarea"
                              @bind="state.Instructions"
                              @oninput="OnInputChanged"
                              placeholder="Додаткові вимоги"></textarea>

                </div>

                <div class="input-group-custom">
                    <div class="mode-title">
                        Кількість завдань
                    </div>
                    

                    <InputNumber class="count-input"
                                 @bind-Value="state.Count"
                                 min="1"
                                 max="20"
                                 @oninput="OnInputChanged" />

                </div>
            }

            @if (state.Mode == GenerationMode.Json)
            {
                <div class="input-group-custom">

                    <label class="custom-label">
                        Назва тесту
                    </label>

                    <input class="custom-input"
                           @bind="state.Topic"
                           @oninput="OnInputChanged"
                           placeholder="Назва тесту" />

                </div>

                <div class="input-group-custom">

                    <label class="custom-label">
                        JSON дані
                    </label>

                    <InputTextArea class="json-area"
                                   @bind-Value="state.UserJson"
                                   @oninput="OnInputChanged" />

                </div>
            }

            @if (state.Mode == GenerationMode.Pdf)
            {
                <div class="input-group-custom">

                    <label class="custom-label">
                        Назва тесту
                    </label>

                    <input class="custom-input"
                           @bind="state.Topic"
                           @oninput="OnInputChanged"
                           placeholder="Назва тесту" />

                </div>

                <div class="input-group-custom">

                    <label class="custom-label">
                        Інструкції PDF
                    </label>

                    <textarea class="custom-textarea"
                              @bind="state.Instructions"
                              @oninput="OnInputChanged"
                              placeholder="Інструкції PDF"></textarea>

                </div>

                <div class="input-group-custom">

                    <label class="custom-label">
                        Кількість завдань
                    </label>

                    <InputNumber class="count-input"
                                 @bind-Value="state.Count"
                                 min="1"
                                 max="20"
                                 @oninput="OnInputChanged" />

                </div>

                <div class="upload-box">

                    <InputFile OnChange="OnPdfSelected"
                               class="upload-input" />

                    @if (!string.IsNullOrEmpty(state.PdfPath))
                    {
                        <div class="upload-success">
                            ✓ PDF завантажено
                        </div>
                    }

                </div>
            }

            <!-- BUTTON -->
            <button class="generate-button"
                    @onclick="Generate"
                    disabled="@(!CanGenerate)">
                ✨ Згенерувати тест
            </button>

            <!-- PROGRESS -->
            @if (loading)
            {
                <div class="progress-wrapper">

                    <div class="custom-progress">

                        <div class="custom-progress-bar"
                             style="width:@($"{progress}%")">

                            @progress%

                        </div>

                    </div>

                    <small class="progress-text">
                        Генерація тестів...
                    </small>

                </div>
            }

        </div>

        <hr class="custom-divider" />

    </div>
}

@if (state.Tests?.Any() == true)
{
    <div class="test-wrapper">

        <div class="questions-navigation">

            @for (int i = 0; i < state.Tests.Count; i++)
            {
                var index = i;

                <button class="question-button @EvaluationService.GetQuestionButtonClass(state, index)"
                        @onclick="() => ButtonShowParticular(index)">
                    @(i + 1)
                </button>
            }

        </div>

        <div class="question-card">

            <div class="question-header">

                <div class="question-title">
                    @state.Tests[state.CurrentQuestion].TaskDescription
                </div>

            </div>

            @if ((state.Tests[state.CurrentQuestion].CorrectAnswerIndexList?.Count ?? 0) > 1)
            {
                <ul class="answers-list">

                    @for (int i = 0; i < state.Tests[state.CurrentQuestion].TaskAnswers.Count; i++)
                    {
                        var iIndex = i;

                        <li class="answer-card"
                            style="@EvaluationService.GetAnswerStyle(state, state.CurrentQuestion, iIndex)">

                            <input type="checkbox"
                                   checked="@state.SelectedCheckbox[state.CurrentQuestion][iIndex]"
                                   @onchange="e => state.SelectedCheckbox[state.CurrentQuestion][iIndex] = (bool)e.Value" />

                            <span>
                                @state.Tests[state.CurrentQuestion].TaskAnswers[iIndex]
                            </span>

                        </li>
                    }

                </ul>
            }
            else
            {
                <ul class="answers-list">

                    @for (int i = 0; i < state.Tests[state.CurrentQuestion].TaskAnswers.Count; i++)
                    {
                        var iIndex = i;

                        <li class="answer-card"
                            style="@EvaluationService.GetAnswerStyle(state, state.CurrentQuestion, iIndex)">

                            <input type="radio"
                                   name="q"
                                   checked="@(state.SelectedRadio[state.CurrentQuestion] == iIndex)"
                                   @onchange="e => state.SelectedRadio[state.CurrentQuestion] = iIndex" />

                            <span>
                                @state.Tests[state.CurrentQuestion].TaskAnswers[iIndex]
                            </span>

                        </li>
                    }

                </ul>
            }

            

        </div>

        <div class="navigation-buttons">

            <button class="nav-button"
                    @onclick="ButtonBack">
                ←
            </button>

            <button class="nav-button"
                    @onclick="ButtonNext">
                →
            </button>

        </div>
        <div class="question-actions">

            @if (IsLastQuestion)
            {
                <button class="finish-button"
                        @onclick="ButtonCheck">
                    Завершити тест
                </button>
            }

            @if (state.ShowResult)
            {
                <div class="result-box">
                    Result: @state.Score / @state.Tests.Count
                </div>
            }

        </div>

    </div>
}

