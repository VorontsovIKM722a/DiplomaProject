@page "/pdf-reader"
@using DiplomaProject.Services
@using DiplomaProject.Models
@using Microsoft.AspNetCore.Components.Forms

@inject GeminiPdfService GeminiPdfService

@rendermode InteractiveServer

<h3>PDF Test (Gemini)</h3>

<InputFile OnChange="OnFileSelected" accept=".pdf" />

@if (!string.IsNullOrEmpty(fileName))
{
    <div class="alert alert-success mt-2">
        📄 @fileName
    </div>
}

<div style="height:10px;"></div>

<input class="form-control"
       type="number"
       @bind="count"
       min="1"
       max="20"
       placeholder="Кількість питань" />

<div style="height:10px;"></div>

<textarea class="form-control"
          @bind="instructions"
          style="height:120px"
              placeholder="Інструкції для AI">
</textarea>

    <div style="height:10px;"></div>

    <button class="btn btn-primary"
            @onclick="Generate">
        Generate
    </button>

    @if (loading)
    {
        <p>⏳ Генерація...</p>
    }

    <hr />

    @if (!string.IsNullOrWhiteSpace(resultJson))
    {
        <h5>Raw JSON</h5>

        <pre style="background:#111;color:#0f0;padding:10px;white-space:pre-wrap;">
@resultJson
    </pre>
    }

    @if (tests?.Any() == true)
    {
        <h5>Parsed Tests: @tests.Count</h5>

        <ul>
            @foreach (var t in tests)
            {
                <li><b>@t.TaskDescription</b></li>
            }
        </ul>
    }

@code {
    private bool loading;

    private int count = 5;
    private string instructions = "";

    private string resultJson = "";
    private List<TestInfo>? tests;

    private string? fileName;
    private string? tempFilePath;

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;

        fileName = file.Name;

        tempFilePath = Path.Combine(Path.GetTempPath(), file.Name);

        await using var fs = File.Create(tempFilePath);
        await file.OpenReadStream(50 * 1024 * 1024)
                  .CopyToAsync(fs);

        await InvokeAsync(StateHasChanged);
    }

    private async Task Generate()
    {
        loading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var result = await GeminiPdfService.GenerateTestsFromPdf(
                tempFilePath ?? "",
                count,
                instructions
            );

            resultJson = result.RawJson;
            tests = result.Tests;
        }
        catch (Exception ex)
        {
            resultJson = "ERROR: " + ex.Message;
            tests = new();
        }
        finally
        {
            loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }
}