@page "/manager-anticheat"
@using DiplomaProject.Models
@using DiplomaProject.Services
@inject IJSRuntime JS

@inject SpotlightService SpotlightService
@inject TabItemService TabItemService
@inject LoadTestService LoadTestService
@inject DeleteTestService DeleteTestService
@inject SaveTestService SaveTestService
@inject TestEvaluationService TestEvaluationService
@inject AntiCheatService AntiCheatService
@rendermode InteractiveServer



    

<div class="manager-container d-flex gap-4 p-3 no-copy"
     tabindex="0"
     @onmousemove="OnMouseMove"
     @onkeydown="BlockKeys"
     @oncontextmenu:preventDefault="true">

    @if (SpotlightService.Enabled)
    {
        <SpotlightOverlay Radius="SpotlightService.Radius"
                          X="x"
                          Y="y" />
    }
        <!-- LEFT PANEL -->
        <div class="sidebar-panel">

            <div class="sidebar-header">
                <h4 class="sidebar-title">Тести</h4>

                <button class="btn-add-test"
                        @onclick="AddTab">
                    + Новий тест
                </button>
            </div>

            <div class="tabs-container">

                @foreach (var tab in Tabs)
                {
                    var isActive = ActiveTab == tab.Id;

                    <div class="tab-card @(isActive ? "active-tab" : "")">

                        <div class="tab-indicator"></div>

                        <button class="tab-button"
                                @onclick="() => SelectTab(tab.Id)">

                            <div class="tab-content">

                                <div class="tab-title">
                                    @tab.Title
                                </div>

                                @if (tab.IsCompleted)
                                {
                                    <div class="completed-badge">
                                        ✓ Завершено
                                    </div>
                                }

                            </div>

                        </button>

                        <button class="delete-button"
                                @onclick="() => ConfirmRemoveTab(tab.Id)">
                            ✕
                        </button>

                    </div>
                }

            </div>

        </div>

        <!-- MAIN -->
        <div class="main-panel">

            <div class="main-card">

                <div class="main-header">
                    <div>

                    
                        <div class="main-subtitle">
                            Проходження тесту
                        </div>
                    </div>
                </div>

                <div class="main-body">

                    @if (ActiveTabItem != null)
                    {
                        <DynamicComponent Type="typeof(TestPage)"
                                          Parameters="@GetParams(ActiveTabItem.Id)"
                                          @key="ActiveTabItem.Id" />
                    }
                    else
                    {
                        <div class="empty-state">
                            Вкладку не вибрано
                        </div>
                    }

                </div>

            </div>

            @if (ActiveTabItem?.State?.ShowResult == true)
            {
                <div class="actions-panel">

                    <button class="save-button"
                            @onclick="SaveActiveTab"
                            disabled="@(!CanSaveActiveTab)">

                        @(ActiveTabItem?.State?.IsSaved == true
                            ? "Результат збережено"
                            : "Зберегти результат")

                    </button>

                    <button class="restart-button"
                            @onclick="RestartTest"
                            disabled="@(ActiveTabItem?.State == null)">
                        Заново
                    </button>

                </div>
            }

            <hr class="custom-divider" />
        <div class="anticheat-panel">

        <div class="anticheat-header">
            <div class="anticheat-title">
                    🛡 Захист від списування
            </div>

            <button class="spotlight-button"
                    @onclick="SpotlightService.Toggle">

                @(SpotlightService.Enabled
                        ? "Вимкнути затемення"
                    : "Увімкнути затемення")

            </button>
        </div>

        <div class="radius-control">

            <div class="radius-label">
                Радіус підсвітки
            </div>

            <input type="range"
                   min="50"
                   max="300"
                   step="10"
                   value="@SpotlightService.Radius"
                   @oninput="OnRadiusChanged"
                   class="radius-slider" />

        </div>

        <div class="monitor-card">

            <div class="monitor-title">
                Активність користувача
            </div>

            <div class="monitor-row">

                <div class="monitor-icon blue">
                    👁
                </div>

                <div>
                    <div class="monitor-value">
                        @tabSwitchCount
                    </div>

                    <div class="monitor-text">
                        Перемикання вкладок
                    </div>
                </div>

            </div>

            <div class="monitor-row">

                <div class="monitor-icon red">
                    📸
                </div>

                <div>
                    <div class="monitor-value">
                        @screenshotCount
                    </div>

                    <div class="monitor-text">
                        Спроби скріншоту
                    </div>
                </div>

            </div>

            @if (tabSwitchCount > 3 || screenshotCount > 2)
            {
                <div class="danger-alert">
                    ⚠ Виявлено підозрілу активність
                </div>
            }

        </div>
        </div>
    </div>
        </div>

    

   

@implements IAsyncDisposable

@code {
    private int tabSwitchCount;
    private int screenshotCount;
    double x = 200;
    double y = 200;

    [JSInvokable]
    public void OnTabHidden()
    {
        tabSwitchCount++;
    }

    [JSInvokable]
    public async Task OnPrintScreen()
    {
        screenshotCount++;

        await AntiCheatService.BlackoutAsync();

        await Task.Delay(3000);

        await AntiCheatService.ResetAsync();

        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnInitializedAsync()
    {
        SpotlightService.OnChange += HandleChange;

        var tabsFromDb = await LoadTestService.LoadTabsAsync();

        TabItemService.Tabs.Clear();
        TabItemService.Tabs.AddRange(tabsFromDb);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await AntiCheatService.InitAsync(this);
            await AntiCheatService.EnableExitWarningAsync();
        }
    }

    private bool CanSaveActiveTab =>
    ActiveTabItem?.State != null &&
    ActiveTabItem.State.Tests?.Count > 0 &&
    ActiveTabItem.State.ShowResult == true &&
    !ActiveTabItem.State.IsSaved;

    private async Task SaveActiveTab()
    {
        var tab = ActiveTabItem;

        if (tab?.State == null || tab.State.IsSaved)
            return;

        var score = TestEvaluationService.CalculateScore(tab.State);

        await SaveTestService.SaveAsync(tab.State, tab.Id);
        await SaveTestService.SaveResultAsync(tab.State, tab.Id, score);

        tab.State.IsSaved = true;

        StateHasChanged();
    }

    private void RestartTest()
    {
        TabItemService.RestartActiveTab();
    }

    private void OnMouseMove(MouseEventArgs e)
    {
        x = e.ClientX;
        y = e.ClientY;
    }

    private async Task AddTab()
        => await TabItemService.AddTabAsync();
    private async Task ConfirmRemoveTab(string id)
    {
        var confirmed = await JS.InvokeAsync<bool>(
             "confirm",
             "Ви точно хочете видалити цей тест та всю інформацію про нього з системи? Цю дію неможливо скасувати."
         );

        if (!confirmed)
            return;

        await RemoveTab(id);
    }
    private async Task RemoveTab(string id)
    {
        await DeleteTestService.DeleteByInstanceIdAsync(id);

        var tab = TabItemService.Tabs.FirstOrDefault(t => t.Id == id);
        if (tab != null)
            TabItemService.Tabs.Remove(tab);
    }

    private void SelectTab(string id)
    {
        TabItemService.SelectTab(id);
        StateHasChanged();
    }

    private void HandleChange()
        => InvokeAsync(StateHasChanged);


    private void OnRadiusChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var value))
        {
            SpotlightService.SetRadius(value);
        }
    }

    private void BlockKeys(KeyboardEventArgs e)
    {
        if (e.CtrlKey)
        {
            var key = e.Key.ToLower();

            if (key is "c" or "s" or "p")
            {
                return;
            }
        }
    }

    List<TabItem> Tabs => TabItemService.Tabs;
    string? ActiveTab => TabItemService.ActiveTab;

    TabItem? ActiveTabItem =>
        Tabs.FirstOrDefault(t => t.Id == ActiveTab);

    Dictionary<string, object> GetParams(string id) =>
        new()
        {
            { "InstanceId", id }
        };

    public async ValueTask DisposeAsync()
    {
        SpotlightService.OnChange -= HandleChange;
    }
}