@page "/manager"
@using DiplomaProject.Models
@using DiplomaProject.Services
@inject IJSRuntime JS
@inject TabItemService TabItemService
@inject LoadTestService LoadTestService
@inject DeleteTestService DeleteTestService
@inject SaveTestService SaveTestService
@inject TestEvaluationService TestEvaluationService

@rendermode InteractiveServer

<div class="manager-container no-copy">

    <!-- LEFT PANEL -->
    <div class="sidebar-panel">

        <div class="sidebar-header">
            <h4 class="sidebar-title">Тести</h4>

            <button class="btn-add-test"
                    @onclick="AddTab">
                + Новий тест
            </button>
        </div>

        <div class="tabs-container">

            @foreach (var tab in Tabs)
            {
                var isActive = ActiveTab == tab.Id;

                <div class="tab-card @(isActive ? "active-tab" : "")">

                    <div class="tab-indicator"></div>

                    <button class="tab-button"
                            @onclick="() => SelectTab(tab.Id)">

                        <div class="tab-content">

                            <div class="tab-title">
                                @tab.Title
                            </div>

                            @if (tab.IsCompleted)
                            {
                                <div class="completed-badge">
                                    ✓ Завершено
                                </div>
                            }

                        </div>

                    </button>

                    <button class="delete-button"
                            @onclick="() => ConfirmRemoveTab(tab.Id)">
                        ✕
                    </button>

                </div>
            }

        </div>

    </div>

    <!-- MAIN -->
    <div class="main-panel">

        <div class="main-card">

            <div class="main-header">
                <div>
                    

                    <div class="main-subtitle">
                        Проходження тесту
                    </div>
                </div>
            </div>

            <div class="main-body">

                @if (ActiveTabItem != null)
                {
                    <DynamicComponent Type="typeof(TestPage)"
                                      Parameters="@GetParams(ActiveTabItem.Id)"
                                      @key="ActiveTabItem.Id" />
                }
                else
                {
                    <div class="empty-state">
                        Вкладку не вибрано
                    </div>
                }

            </div>

        </div>

        @if (ActiveTabItem?.State?.ShowResult == true)
        {
            <div class="actions-panel">

                <button class="save-button"
                        @onclick="SaveActiveTab"
                        disabled="@(!CanSaveActiveTab)">

                    @(ActiveTabItem?.State?.IsSaved == true
                        ? "Результат збережено"
                        : "Зберегти результат")

                </button>

                <button class="restart-button"
                        @onclick="RestartTest"
                        disabled="@(ActiveTabItem?.State == null)">
                    Почати нову сесію тестування
                </button>

            </div>
        }

        <hr class="custom-divider" />

    </div>

</div>


@code {
    private bool CanSaveActiveTab =>
    ActiveTabItem?.State != null &&
    ActiveTabItem.State.Tests?.Count > 0 &&
    ActiveTabItem.State.ShowResult &&
    !ActiveTabItem.State.IsSaved;

    private async Task SaveActiveTab()
    {
        var tab = ActiveTabItem;

        if (tab?.State == null || tab.State.IsSaved)
            return;

        var score = TestEvaluationService.CalculateScore(tab.State);

        await SaveTestService.SaveAsync(tab.State, tab.Id);
        await SaveTestService.SaveResultAsync(tab.State, tab.Id, score);

        tab.State.IsSaved = true;
        TabItemService.NotifyStateChanged();
        
    }
    private void RestartTest()
    {
        TabItemService.RestartActiveTab();
        TabItemService.NotifyStateChanged();
    }

    private async Task AddTab()
    {
        await TabItemService.AddTabAsync();
    }
    private async Task ConfirmRemoveTab(string id)
    {
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            "Ви точно хочете видалити цей тест та всю інформацію про нього з системи? Цю дію неможливо скасувати."
        );

        if (!confirmed)
            return;

        await RemoveTab(id);
    }
    private async Task RemoveTab(string id)
    {
        await DeleteTestService.DeleteByInstanceIdAsync(id);

        var tab = TabItemService.Tabs.FirstOrDefault(t => t.Id == id);
        if (tab != null)
            TabItemService.Tabs.Remove(tab);
    }
    protected override async Task OnInitializedAsync()
    {
        var tabsFromDb = await LoadTestService.LoadTabsAsync();

        TabItemService.Tabs.Clear();
        TabItemService.Tabs.AddRange(tabsFromDb);
    }

    private void SelectTab(string id)
    {
        TabItemService.SelectTab(id);
        StateHasChanged();
    }
    protected override void OnInitialized()
    {
        TabItemService.OnChange += StateHasChanged;
    }
    public void Dispose()
    {
        TabItemService.OnChange -= StateHasChanged;
    }
    List<TabItem> Tabs => TabItemService.Tabs;

    string? ActiveTab => TabItemService.ActiveTab;

    TabItem? ActiveTabItem =>
        Tabs.FirstOrDefault(t => t.Id == ActiveTab);

    Dictionary<string, object> GetParams(string id) =>
        new()
        {
        { "InstanceId", id }
        };
}