@page "/manager"
@using DiplomaProject.Models
@using DiplomaProject.Services
@inject IJSRuntime JS
@inject TabItemService TabItemService
@inject LoadTestService LoadTestService
@inject DeleteTestService DeleteTestService
@inject SaveTestService SaveTestService
@inject TestEvaluationService TestEvaluationService

@rendermode InteractiveServer

<div class="manager-container no-copy">

    <!-- LEFT PANEL -->
    <div class="sidebar-panel">

        <div class="sidebar-header">
            <h4 class="sidebar-title">Тести</h4>

            <button class="btn-add-test"
                    @onclick="AddTab">
                + Новий тест
            </button>
        </div>

        <div class="tabs-container">

            @foreach (var tab in Tabs)
            {
                var isActive = ActiveTab == tab.Id;

                <div class="tab-card @(isActive ? "active-tab" : "")">

                    <div class="tab-indicator"></div>

                    <button class="tab-button"
                            @onclick="() => SelectTab(tab.Id)">

                        <div class="tab-content">

                            <div class="tab-title">
                                @tab.Title
                            </div>

                            @if (tab.IsCompleted)
                            {
                                <div class="completed-badge">
                                    ✓ Завершено
                                </div>
                            }

                        </div>

                    </button>

                    <button class="delete-button"
                            @onclick="() => ConfirmRemoveTab(tab.Id)">
                        ✕
                    </button>

                </div>
            }

        </div>

    </div>

    <!-- MAIN -->
    <div class="main-panel">

        <div class="main-card">

            <div class="main-header">
                <div>
                    

                    <div class="main-subtitle">
                        Проходження тесту
                    </div>
                </div>
            </div>

            <div class="main-body">

                @if (ActiveTabItem != null)
                {
                    <DynamicComponent Type="typeof(TestPage)"
                                      Parameters="@GetParams(ActiveTabItem.Id)"
                                      @key="ActiveTabItem.Id" />
                }
                else
                {
                    <div class="empty-state">
                        Вкладку не вибрано
                    </div>
                }

            </div>

        </div>

        @if (ActiveTabItem?.State?.ShowResult == true)
        {
            <div class="actions-panel">

                <button class="save-button"
                        @onclick="SaveActiveTab"
                        disabled="@(!CanSaveActiveTab)">

                    @(ActiveTabItem?.State?.IsSaved == true
                        ? "Результат збережено"
                        : "Зберегти результат")

                </button>

                <button class="restart-button"
                        @onclick="RestartTest"
                        disabled="@(ActiveTabItem?.State == null)">
                    Заново
                </button>

            </div>
        }

        <hr class="custom-divider" />

    </div>

</div>

<style>

    .no-copy {
        user-select: none;
        -webkit-user-select: none;
        -ms-user-select: none;
    }

    .manager-container {
        display: flex;
        gap: 28px;
        padding: 24px;
        min-height: 100vh;
        background: linear-gradient(to bottom right, #f8fafc, #eef2ff);
    }

    /* SIDEBAR */

    .sidebar-panel {
        width: 360px;
        background: white;
        border-radius: 26px;
        padding: 22px;
        box-shadow: 0 10px 35px rgba(0,0,0,0.08);
        display: flex;
        flex-direction: column;
        height: fit-content;
        border: 1px solid #e5e7eb;
    }

    .sidebar-header {
        margin-bottom: 22px;
    }

    .sidebar-title {
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 18px;
        color: #111827;
    }

    .btn-add-test {
        width: 100%;
        border: none;
        border-radius: 16px;
        padding: 14px;
        background: linear-gradient(135deg, #2563eb, #4f46e5);
        color: white;
        font-size: 16px;
        font-weight: 600;
        transition: 0.2s ease;
        box-shadow: 0 6px 18px rgba(37,99,235,0.25);
    }

        .btn-add-test:hover {
            transform: translateY(-2px);
            opacity: 0.96;
        }

    .tabs-container {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .tab-card {
        display: flex;
        align-items: center;
        gap: 12px;
        border-radius: 18px;
        padding: 12px;
        background: #f9fafb;
        border: 1px solid transparent;
        transition: 0.2s ease;
    }

        .tab-card:hover {
            transform: translateY(-1px);
            background: #f3f4f6;
        }

    .active-tab {
        background: linear-gradient(135deg, #eef2ff, #dbeafe);
        border: 1px solid #93c5fd;
        box-shadow: 0 6px 20px rgba(59,130,246,0.14);
    }

    .tab-indicator {
        width: 6px;
        height: 52px;
        border-radius: 999px;
        background: transparent;
        transition: 0.2s ease;
    }

    .active-tab .tab-indicator {
        background: #2563eb;
    }

    .tab-button {
        flex-grow: 1;
        border: none;
        background: transparent;
        text-align: left;
        padding: 0;
    }

    .tab-content {
        overflow: hidden;
    }

    .tab-title {
        font-size: 16px;
        font-weight: 600;
        color: #111827;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .completed-badge {
        margin-top: 6px;
        display: inline-block;
        padding: 4px 10px;
        border-radius: 999px;
        background: rgba(34,197,94,0.12);
        color: #15803d;
        font-size: 12px;
        font-weight: 600;
    }

    .delete-button {
        border: none;
        width: 38px;
        height: 38px;
        border-radius: 12px;
        background: rgba(239,68,68,0.08);
        color: #dc2626;
        font-weight: 700;
        transition: 0.2s ease;
    }

        .delete-button:hover {
            background: rgba(239,68,68,0.16);
            transform: scale(1.05);
        }

    /* MAIN */

    .main-panel {
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }

    .main-card {
        background: white;
        border-radius: 28px;
        overflow: hidden;
        box-shadow: 0 10px 35px rgba(0,0,0,0.08);
        border: 1px solid #e5e7eb;
    }

    .main-header {
        padding: 24px 28px;
        border-bottom: 1px solid #f1f5f9;
        background: linear-gradient(to right, #ffffff, #f8fafc);
    }

    .main-label {
        font-size: 14px;
        color: #6b7280;
        margin-bottom: 6px;
    }

    .main-subtitle {
        font-size: 28px;
        font-weight: 700;
        color: #111827;
    }

    .main-body {
        padding: 28px;
        min-height: 500px;
    }

    .empty-state {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 240px;
        border-radius: 20px;
        background: #f9fafb;
        color: #6b7280;
        font-size: 18px;
        border: 2px dashed #d1d5db;
    }

    /* ACTIONS */

    .actions-panel {
        display: flex;
        gap: 16px;
        margin-top: 24px;
        flex-wrap: wrap;
    }

    .save-button,
    .restart-button {
        border: none;
        border-radius: 16px;
        padding: 14px 22px;
        font-size: 16px;
        font-weight: 600;
        transition: 0.2s ease;
    }

    .save-button {
        background: linear-gradient(135deg, #16a34a, #22c55e);
        color: white;
        box-shadow: 0 6px 18px rgba(34,197,94,0.22);
    }

        .save-button:hover:not(:disabled) {
            transform: translateY(-2px);
        }

    .restart-button {
        background: linear-gradient(135deg, #f59e0b, #fbbf24);
        color: white;
        box-shadow: 0 6px 18px rgba(245,158,11,0.22);
    }

        .restart-button:hover:not(:disabled) {
            transform: translateY(-2px);
        }

        .save-button:disabled,
        .restart-button:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }

    .custom-divider {
        margin-top: 30px;
        border: none;
        border-top: 1px solid #dbe4f0;
    }

</style>

@code {
    private bool CanSaveActiveTab =>
    ActiveTabItem?.State != null &&
    ActiveTabItem.State.Tests?.Count > 0 &&
    ActiveTabItem.State.ShowResult &&
    !ActiveTabItem.State.IsSaved;

    private async Task SaveActiveTab()
    {
        var tab = ActiveTabItem;

        if (tab?.State == null || tab.State.IsSaved)
            return;

        var score = TestEvaluationService.CalculateScore(tab.State);

        await SaveTestService.SaveAsync(tab.State, tab.Id);
        await SaveTestService.SaveResultAsync(tab.State, tab.Id, score);

        tab.State.IsSaved = true;
        TabItemService.NotifyStateChanged();
        
    }
    private void RestartTest()
    {
        TabItemService.RestartActiveTab();
        TabItemService.NotifyStateChanged();
    }

    private async Task AddTab()
    {
        await TabItemService.AddTabAsync();
    }
    private async Task ConfirmRemoveTab(string id)
    {
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            "Ви точно хочете видалити цей тест? Цю дію неможливо скасувати."
        );

        if (!confirmed)
            return;

        await RemoveTab(id);
    }
    private async Task RemoveTab(string id)
    {
        await DeleteTestService.DeleteByInstanceIdAsync(id);

        var tab = TabItemService.Tabs.FirstOrDefault(t => t.Id == id);
        if (tab != null)
            TabItemService.Tabs.Remove(tab);
    }
    protected override async Task OnInitializedAsync()
    {
        var tabsFromDb = await LoadTestService.LoadTabsAsync();

        TabItemService.Tabs.Clear();
        TabItemService.Tabs.AddRange(tabsFromDb);
    }

    private void SelectTab(string id)
    {
        TabItemService.SelectTab(id);
        StateHasChanged();
    }
    protected override void OnInitialized()
    {
        TabItemService.OnChange += StateHasChanged;
    }
    public void Dispose()
    {
        TabItemService.OnChange -= StateHasChanged;
    }
    List<TabItem> Tabs => TabItemService.Tabs;

    string? ActiveTab => TabItemService.ActiveTab;

    TabItem? ActiveTabItem =>
        Tabs.FirstOrDefault(t => t.Id == ActiveTab);

    Dictionary<string, object> GetParams(string id) =>
        new()
        {
        { "InstanceId", id }
        };
}