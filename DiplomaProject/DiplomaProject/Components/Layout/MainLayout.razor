@inherits LayoutComponentBase

<div class="page">

    <NavMenu />

    <main class="main-content">
        <article class="content">
            @Body
        </article>
    </main>

</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

<style>
    .page {
        min-height: 100vh;
    }

    .main-content {
        width: 100%;
        min-height: 100vh;
    }

    .content {
        width: 100%;
    }
</style>