@page "/manager-anticheat"
@using DiplomaProject.Models
@using DiplomaProject.Services
@inject IJSRuntime JS

@inject SpotlightService SpotlightService
@inject TabItemService TabItemService
@inject LoadTestService LoadTestService
@inject DeleteTestService DeleteTestService
@inject SaveTestService SaveTestService
@inject TestEvaluationService TestEvaluationService
@inject AntiCheatService AntiCheatService
@rendermode InteractiveServer



    

<div class="manager-container d-flex gap-4 p-3 no-copy"
     tabindex="0"
     @onmousemove="OnMouseMove"
     @onkeydown="BlockKeys"
     @oncontextmenu:preventDefault="true">

    @if (SpotlightService.Enabled)
    {
        <SpotlightOverlay Radius="SpotlightService.Radius"
                          X="x"
                          Y="y" />
    }
        <!-- LEFT PANEL -->
        <div class="sidebar-panel">

            <div class="sidebar-header">
                <h4 class="sidebar-title">Тести</h4>

                <button class="btn-add-test"
                        @onclick="AddTab">
                    + Новий тест
                </button>
            </div>

            <div class="tabs-container">

                @foreach (var tab in Tabs)
                {
                    var isActive = ActiveTab == tab.Id;

                    <div class="tab-card @(isActive ? "active-tab" : "")">

                        <div class="tab-indicator"></div>

                        <button class="tab-button"
                                @onclick="() => SelectTab(tab.Id)">

                            <div class="tab-content">

                                <div class="tab-title">
                                    @tab.Title
                                </div>

                                @if (tab.IsCompleted)
                                {
                                    <div class="completed-badge">
                                        ✓ Завершено
                                    </div>
                                }

                            </div>

                        </button>

                        <button class="delete-button"
                                @onclick="() => ConfirmRemoveTab(tab.Id)">
                            ✕
                        </button>

                    </div>
                }

            </div>

        </div>

        <!-- MAIN -->
        <div class="main-panel">

            <div class="main-card">

                <div class="main-header">
                    <div>

                    
                        <div class="main-subtitle">
                            Проходження тесту
                        </div>
                    </div>
                </div>

                <div class="main-body">

                    @if (ActiveTabItem != null)
                    {
                        <DynamicComponent Type="typeof(TestPage)"
                                          Parameters="@GetParams(ActiveTabItem.Id)"
                                          @key="ActiveTabItem.Id" />
                    }
                    else
                    {
                        <div class="empty-state">
                            Вкладку не вибрано
                        </div>
                    }

                </div>

            </div>

            @if (ActiveTabItem?.State?.ShowResult == true)
            {
                <div class="actions-panel">

                    <button class="save-button"
                            @onclick="SaveActiveTab"
                            disabled="@(!CanSaveActiveTab)">

                        @(ActiveTabItem?.State?.IsSaved == true
                            ? "Результат збережено"
                            : "Зберегти результат")

                    </button>

                    <button class="restart-button"
                            @onclick="RestartTest"
                            disabled="@(ActiveTabItem?.State == null)">
                        Заново
                    </button>

                </div>
            }

            <hr class="custom-divider" />
        <div class="anticheat-panel">

        <div class="anticheat-header">
            <div class="anticheat-title">
                🛡 Античіт-моніторинг
            </div>

            <button class="spotlight-button"
                    @onclick="SpotlightService.Toggle">

                @(SpotlightService.Enabled
                    ? "Вимкнути Spotlight"
                    : "Увімкнути Spotlight")

            </button>
        </div>

        <div class="radius-control">

            <div class="radius-label">
                Радіус підсвітки
            </div>

            <input type="range"
                   min="50"
                   max="300"
                   step="10"
                   value="@SpotlightService.Radius"
                   @oninput="OnRadiusChanged"
                   class="radius-slider" />

        </div>

        <div class="monitor-card">

            <div class="monitor-title">
                Активність користувача
            </div>

            <div class="monitor-row">

                <div class="monitor-icon blue">
                    👁
                </div>

                <div>
                    <div class="monitor-value">
                        @tabSwitchCount
                    </div>

                    <div class="monitor-text">
                        Перемикання вкладок
                    </div>
                </div>

            </div>

            <div class="monitor-row">

                <div class="monitor-icon red">
                    📸
                </div>

                <div>
                    <div class="monitor-value">
                        @screenshotCount
                    </div>

                    <div class="monitor-text">
                        Спроби скріншоту
                    </div>
                </div>

            </div>

            @if (tabSwitchCount > 3 || screenshotCount > 2)
            {
                <div class="danger-alert">
                    ⚠ Виявлено підозрілу активність
                </div>
            }

        </div>
        </div>
    </div>
        </div>

    

