@page "/test"
@using DiplomaProject.Services
@using DiplomaProject.Models

@inject TestGeneration TestGeneration
@inject TabItemService TabItemService
@inject GeminiTestGeneration GeminiTestGeneration
@inject TestEvaluationService EvaluationService
@inject JsonDataService JsonDataService

@rendermode InteractiveServer

@if (state == null)
{
    <div class="alert alert-warning">
        Немає активної вкладки
    </div>
}
else
{
    <h3>Test Generator</h3>

    <div class="form-check mb-3">
        <input class="form-check-input"
               type="checkbox"
               @bind="state.UseJsonInput" />

        <label class="form-check-label">
            Використати власний JSON
        </label>
    </div>

    @if (state.UseJsonInput)
    {
        <input class="form-control"
               style="width:300px; margin-bottom:10px;"
               @bind="state.Topic"
               placeholder="Введіть тему тесту:" />

        <InputTextArea class="form-control"
                       style="height:300px"
                       @bind-Value="state.UserJson" />

        <div style="height: 10px;"></div>
    }

    else
    {
        <input class="form-control"
               style="width:300px"
               @bind="state.Topic"
               placeholder="Введіть тему тесту:" />

        <div style="height: 10px;"></div>

        <InputNumber @bind-Value="state.Count"
                     min="1"
                     max="20"
                     class="form-control"
                     style="width:120px" />

        <div style="height: 10px;"></div>
    }

    <button class="btn btn-primary"
            @onclick="Generate"
            disabled="@state.IsGenerated">
        Generate tests
    </button>

    @if (loading)
    {
        <div class="alert alert-info">
            Генерація тестів...
        </div>
    }

    <hr />

    @if (state.Tests?.Any() == true)
    {
        <div class="d-flex gap-2 flex-wrap">
            @for (int i = 0; i < state.Tests.Count; i++)
            {
                var index = i;

                <button class="btn @EvaluationService.GetQuestionButtonClass(state, index)"
                        @onclick="() => ButtonShowParticular(index)">
                    @(i + 1)
                </button>
            }
        </div>

        <div style="height: 20px;"></div>

        @if (state.CurrentQuestion < state.Tests.Count)
        {
            var tIndex = state.CurrentQuestion;

            <h4>#@(tIndex + 1)</h4>
            <h4>@state.Tests[tIndex].TaskDescription</h4>

            @if ((state.Tests[tIndex].CorrectAnswerIndexList?.Count ?? 0) > 1)
            {
                <ul>
                    @for (int i = 0; i < state.Tests[tIndex].TaskAnswers.Count; i++)
                    {
                        var iIndex = i;

                        <li style="@EvaluationService.GetAnswerStyle(state, tIndex, iIndex)">
                            <input type="checkbox"
                                   checked="@state.SelectedCheckbox[tIndex][iIndex]"
                                   disabled="@state.ShowResult"
                                   @onchange="e => state.SelectedCheckbox[tIndex][iIndex] = (bool)e.Value" />

                            @state.Tests[tIndex].TaskAnswers[iIndex]
                        </li>
                    }
                </ul>
            }
            else
            {
                <ul>
                    @for (int i = 0; i < state.Tests[tIndex].TaskAnswers.Count; i++)
                    {
                        var iIndex = i;

                        <li style="@EvaluationService.GetAnswerStyle(state, tIndex, iIndex)">
                            <input type="radio"
                                   name="q"
                                   checked="@(state.SelectedRadio[tIndex] == iIndex)"
                                   disabled="@state.ShowResult"
                                   @onchange="e => state.SelectedRadio[tIndex] = iIndex" />

                            @state.Tests[tIndex].TaskAnswers[iIndex]
                        </li>
                    }
                </ul>
            }
        }

        @if (state.CurrentQuestion >= state.Tests.Count)
        {
            <div>
                <button class="btn btn-primary" @onclick="ButtonCheck">
                    Check your answers
                </button>
            </div>

            @if (state.ShowResult)
            {
                <h4>Result: @state.Score / @state.Tests.Count</h4>
            }
        }

        <div style="height: 75px;"></div>

        <div style="position: fixed; bottom: 20px; left: 275px;">
            <button class="btn btn-primary" @onclick="ButtonBack">
                Previous question
            </button>
        </div>

        <div style="position: fixed; bottom: 20px; left: 475px;">
            <button class="btn btn-primary" @onclick="ButtonNext">
                Next question
            </button>
        </div>

        <div style="height: 500px;"></div>

        <h5>Raw Gemini Response:</h5>
    }

    @if (!string.IsNullOrWhiteSpace(state.RawResponse))
    {
        <div class="card p-2 mb-3">
            <h6>Raw Response</h6>

            <pre style="background:#111; color:#0f0; padding:10px; white-space:pre-wrap;">
                @state.RawResponse
            </pre>
        </div>
    }
}

@code {

    private bool loading;
    TestState state;

    [Parameter]
    public string InstanceId { get; set; }

    protected override void OnParametersSet()
    {
        var tab = TabItemService.Tabs
            .FirstOrDefault(t => t.Id == InstanceId);

        state = tab?.State;
    }

    private async Task Generate()
    {
        if (state == null)
            return;

        if (string.IsNullOrWhiteSpace(state.Topic))
        {
            state.RawResponse = "ПОМИЛКА: введіть тему тесту";
            return;
        }

        loading = true;

        try
        {
            GeminiResult result;
            if (state.UseJsonInput)
            {
                var tests = JsonDataService.DeserializeTests(state.UserJson);

                result = new GeminiResult
                {
                    Tests = tests,
                    RawJson = state.UserJson
                };

                state.UseJsonInput = false;
                state.UserJson = "";
            }
            else
            {
                if (state.Count <= 0)
                    state.Count = 5;

                if (state.Count > 20)
                    state.Count = 20;

                result = await GeminiTestGeneration.GenerateTests(
                    state.Topic,
                    state.Count
                );
            }

            ApplyTests(result);
            UpdateTab(tab =>
            {
                tab.Title = state.Topic;
                tab.IsCompleted = false;
            });
        }
        finally
        {
            loading = false;
        }

        StateHasChanged();
    }

    private void ApplyTests(GeminiResult result)
    {
        state.RawResponse = result.RawJson;
        state.Tests = result.Tests ?? new();

        state.SelectedCheckbox = state.Tests
            .Select(t => (t.TaskAnswers ?? new()).Select(_ => false).ToList())
            .ToList();

        state.SelectedRadio = state.Tests
            .Select(_ => -1)
            .ToList();

        state.CurrentQuestion = 0;
        state.ShowResult = false;
        state.Score = 0;
    }
    private void UpdateTab(Action<TabItem> action)
    {
        var tab = TabItemService.Tabs
            .FirstOrDefault(t => t.Id == InstanceId);

        if (tab != null)
            action(tab);
    }

    private void ButtonCheck()
    {
        state.Score = EvaluationService.CalculateScore(state);
        state.ShowResult = true;

        UpdateTab(tab => tab.IsCompleted = true);

        StateHasChanged();
    }

    private void ButtonNext()
    {
        if (state.CurrentQuestion < state.Tests.Count)
            state.CurrentQuestion++;
    }

    private void ButtonBack()
    {
        if (state.CurrentQuestion > 0)
            state.CurrentQuestion--;
    }

    private void ButtonShowParticular(int index)
    {
        state.CurrentQuestion = index;
    }
}