@page "/gemini"
@using DiplomaProject.Services
@using DiplomaProject.Models
@inject GeminiTestGeneration GeminiTestGeneration //GeminiTestGenerationMock - підключає сервіс з локальними даними типу Json /   GeminiTestGeneration - сервіс з Gemini API //

@rendermode InteractiveServer

<h3>TestPage</h3>
<input class="form-control"
       style="width:300px"
       @bind="topic"
       placeholder="Введи тему тесту..." />

<div style="height: 10px;"></div>

<InputNumber @bind-Value="count"
             min="1"
             max="20"
             class="form-control" />

<div style="height: 10px;"></div>
<button class="btn btn-primary" @onclick="Generate" disabled="@loading">
    Generate tests
</button>

<hr />

@if (loading)
{
    <p>Генерація тестів...</p>
}
else if (result?.Tests != null && result.Tests.Any())
{
    <div class="d-flex gap-2 flex-wrap">
        @for (int i = 0; i < result.Tests.Count; i++)
        {
            var index = i;
            <button class="btn @GetQuestionButtonClass(index)"
                    @onclick="() => ButtonShowParticular(index)">
                @(i + 1)
            </button>
        }
    </div>

    <div style="height: 20px;"></div>

    @if (currentIndex < result.Tests.Count)
    {
        var tIndex = currentIndex;

        <div>
            <h4>#@(tIndex + 1)</h4>
            <h4>@result.Tests[tIndex].TaskDescription</h4>

            @if ((result.Tests[tIndex].CorrectAnswerIndexList?.Count ?? 0) > 1)
            {
                <ul>
                    @for (int i = 0; i < result.Tests[tIndex].TaskAnswers.Count; i++)
                    {
                        var iIndex = i;

                        <li>
                            <input type="checkbox"
                                   checked="@selectedCheckbox[tIndex][iIndex]"
                                   @onchange="e => selectedCheckbox[tIndex][iIndex] = (bool)e.Value" />

                            @result.Tests[tIndex].TaskAnswers[iIndex]
                        </li>
                    }
                </ul>
            }
            else
            {
                <ul>
                    @for (int i = 0; i < result.Tests[tIndex].TaskAnswers.Count; i++)
                    {
                        var iIndex = i;

                        <li>
                            <input type="radio"
                                   name="q"
                                   checked="@(selectedRadio[tIndex] == iIndex)"
                                   @onchange="e => selectedRadio[tIndex] = iIndex" />

                            @result.Tests[tIndex].TaskAnswers[iIndex]
                        </li>
                    }
                </ul>
            }
        </div>
    }

    @if (currentIndex >= result.Tests.Count)
    {
        <div>
            <button class="btn btn-primary" @onclick="Check">
                Check your answers
            </button>
        </div>

        @if (showResult)
        {
            <h4>Result: @score / @result.Tests.Count</h4>
        }
    }

    <div style="height: 20px;"></div>

    <div style="position: fixed; bottom: 20px; left: 275px;">
        <button class="btn btn-primary" @onclick="ButtonBack">
            Previous question
        </button>
    </div>

    <div style="position: fixed; bottom: 20px; left: 475px;">
        <button class="btn btn-primary" @onclick="ButtonNext">
            Next question
        </button>
    </div>
}
else
{
    <div class="alert alert-warning">
        Немає згенерованих тестів
    </div>
}

<hr />

<h5>Raw Gemini Response:</h5>
<pre style="background:#111; color:#0f0; padding:10px; white-space:pre-wrap;">
@result?.RawJson
</pre>

@code {
    private int count;
    private string topic;
    private GeminiResult result;
    private bool loading;

    private int currentIndex;

    private List<List<bool>> selectedCheckbox = new();
    private List<int> selectedRadio = new();

    private bool showResult;
    private int score;

    private async Task Generate()
    {
        if (count <= 0)
            count = 5;

        if (count > 20)
            count = 20;

        if (string.IsNullOrWhiteSpace(topic))
            return;

        loading = true;
        result = null;

        try
        {
            result = await GeminiTestGeneration.GenerateTests(topic, count);
            InitState();
        }
        finally
        {
            loading = false;
        }
    }

    private void InitState()
    {
        if (result?.Tests == null || !result.Tests.Any())
            return;

        selectedCheckbox = result.Tests
            .Select(t => (t.TaskAnswers ?? new()).Select(_ => false).ToList())
            .ToList();

        selectedRadio = result.Tests
            .Select(_ => -1)
            .ToList();

        currentIndex = 0;
        showResult = false;
        score = 0;
    }

    private void Check()
    {
        score = result.Tests.Count;
        showResult = true;
    }

    private void ButtonNext()
    {
        if (currentIndex < result.Tests.Count)
            currentIndex++;
    }

    private void ButtonBack()
    {
        if (currentIndex > 0)
            currentIndex--;
    }

    private void ButtonShowParticular(int index)
    {
        currentIndex = index;
    }

    private string GetQuestionButtonClass(int index)
    {
        return currentIndex == index
            ? "btn-primary"
            : "btn-outline-secondary";
    }
}