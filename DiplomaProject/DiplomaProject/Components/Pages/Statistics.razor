@page "/statistics"
@using DiplomaProject.Services
@inject TestStatisticsService StatisticsService
<div class="page-content">

    <h3 class="page-title">Статистика</h3>

    @if (tabs == null)
    {
        <div class="loading-box">
            <p>Завантаження...</p>
        </div>
    }
    else if (!tabs.Any())
    {
        <div class="empty-box">
            <p>Немає результатів</p>
        </div>
    }
    else
    {
        <div class="statistics-container">

            @foreach (var tab in tabs)
            {
            <details class="statistics-item">

                <summary class="statistics-summary">

                    <div class="summary-header">
                        <div class="summary-title-block">
                            <div class="summary-title">
                                @tab.Title
                            </div>

                            <div class="summary-badge">
                                Кількість спроб: @tab.AttemptsCount
                            </div>
                        </div>
                    </div>

                    <div class="summary-info">
                        <div class="info-card">
                            <span class="info-label">Середній бал</span>
                            <span class="info-value">
                                @tab.AverageScore.ToString("0.00") / @tab.MaxScore
                            </span>
                        </div>

                        <div class="info-card">
                            <span class="info-label">Максимальний бал</span>
                            <span class="info-value">
                                @tab.MaxScore
                            </span>
                        </div>
                    </div>

                </summary>

                <div class="attempts-container">

                    @foreach (var attempt in tab.Attempts)
                    {
                        <div class="attempt-card">

                            <div class="attempt-header">

                                <div class="score-block">
                                    <span class="score-label">Бал</span>

                                    <span class="score-value"
                                          style="color:@GetAttemptScoreColor(attempt.Score, tab.MaxScore)">
                                        @attempt.Score / @tab.MaxScore
                                    </span>
                                </div>

                                <div class="date-block">
                                    <span class="date-label">Дата проходження</span>

                                    <span class="date-value">
                                        @attempt.CreatedAt
                                    </span>
                                </div>

                            </div>

                            <div class="answers-grid">

                                @foreach (var ans in attempt.Answers)
                                {
                                    <div class="answer-item @(ans.IsCorrect ? "correct" : "incorrect")">

                                        <span class="question-number">
                                            @(ans.QuestionIndex + 1)
                                        </span>

                                        <span class="answer-icon">
                                            @(ans.IsCorrect ? "✔" : "✖")
                                        </span>

                                    </div>
                                }

                            </div>

                        </div>
                    }

                </div>

            </details>
        }

    </div>
    }

</div>



@code {
    private List<TabStatisticsDto>? tabs;

    protected override async Task OnInitializedAsync()
    {
        var raw = await StatisticsService.GetStatisticsAsync();
        tabs = StatisticsService.BuildStatistics(raw);
    }

    private string GetAttemptScoreColor(int score, int maxScore)
    {
        if (maxScore <= 0)
            return "#111827";

        var ratio = (double)score / maxScore;

        return ratio < 0.5 ? "#dc2626" : "#16a34a";
    }
}