@page "/manager"
@using DiplomaProject.Models
@using DiplomaProject.Services

@inject SpotlightService SpotlightService
@inject TabItemService TabItemService
@inject LoadTestService LoadTestService
@inject DeleteTestService DeleteTestService
@inject SaveTestService SaveTestService
@inject TestEvaluationService TestEvaluationService

@rendermode InteractiveServer

<div class="manager-container"
     @onmousemove="OnMouseMove">

    @if (SpotlightService.Enabled)
    {
        <SpotlightOverlay Radius="SpotlightService.Radius"
                          X="x"
                          Y="y" />
    }

    <button class="btn btn-primary mb-3"
            @onclick="AddTab">
        + Нова вкладка
    </button>

    <div class="d-flex flex-column gap-2" style="max-width: 320px;">

        @foreach (var tab in Tabs)
        {
            <div class="d-flex align-items-center gap-2">

                <button class="btn @(tab.IsCompleted ? "btn-warning" : "btn-secondary")"
                        style="flex: 1;
                    text-align: left;
                    overflow: hidden;
                    text-overflow: ellipsis;
                    white-space: nowrap;"
                        title="@tab.Title"
                        @onclick="() => SelectTab(tab.Id)">
                    @tab.Title
                </button>

                <button class="btn btn-danger btn-sm"
                        style="flex-shrink: 0;"
                        @onclick="() => RemoveTab(tab.Id)">
                    ✕
                </button>

            </div>
        }

    </div>

    <hr />

    @if (ActiveTabItem != null)
    {
        <DynamicComponent Type="typeof(TestPage)"
                          Parameters="@GetParams(ActiveTabItem.Id)" />
    }

    <button class="btn btn-success mt-2"
            @onclick="SaveActiveTab"
            disabled="@(!CanSaveActiveTab)">
        Save test
    </button>

    <hr />

    <button class="btn btn-dark"
            @onclick="SpotlightService.Toggle">
        @(SpotlightService.Enabled ? "Disable spotlight" : "Enable spotlight")
    </button>

    <div style="width: 250px;">
        <input type="range"
               min="50"
               max="300"
               step="10"
               value="@SpotlightService.Radius"
               @oninput="OnRadiusChanged"
               class="form-range" />
    </div>

</div>

@code {
    double x = 200;
    double y = 200;

    protected override async Task OnInitializedAsync()
    {
        SpotlightService.OnChange += HandleChange;

        var tabsFromDb = await LoadTestService.LoadTabsAsync();

        TabItemService.Tabs.Clear();
        TabItemService.Tabs.AddRange(tabsFromDb);
    }

    private bool CanSaveActiveTab =>
        ActiveTabItem?.State != null &&
        ActiveTabItem.State.Tests?.Count > 0 &&
        ActiveTabItem.State.ShowResult == true;

    private async Task SaveActiveTab()
    {
        var tab = ActiveTabItem;

        if (tab?.State == null)
            return;

        var score = TestEvaluationService.CalculateScore(tab.State);

        await SaveTestService.SaveAsync(tab.State, tab.Id);
        await SaveTestService.SaveResultAsync(tab.State, tab.Id, score);
    }

    private void OnMouseMove(MouseEventArgs e)
    {
        x = e.ClientX;
        y = e.ClientY;
    }

    private async Task AddTab()
    {
        await TabItemService.AddTabAsync();
    }

    private async Task RemoveTab(string id)
    {
        await DeleteTestService.DeleteByInstanceIdAsync(id);

        var tab = TabItemService.Tabs.FirstOrDefault(t => t.Id == id);
        if (tab != null)
            TabItemService.Tabs.Remove(tab);
    }

    private void SelectTab(string id)
    {
        TabItemService.SelectTab(id);
    }

    private void HandleChange()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SpotlightService.OnChange -= HandleChange;
    }

    private void OnRadiusChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var value))
        {
            SpotlightService.SetRadius(value);
        }
    }

    List<TabItem> Tabs => TabItemService.Tabs;

    string? ActiveTab => TabItemService.ActiveTab;

    TabItem? ActiveTabItem =>
        Tabs.FirstOrDefault(t => t.Id == ActiveTab);

    Dictionary<string, object> GetParams(string id) =>
        new()
        {
            { "InstanceId", id }
        };
}